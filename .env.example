# abhix-portfolio-lambda — Environment Variables
# Copy to .env and fill in real values. Never commit .env.

# ── Gmail SMTP ────────────────────────────────────────────────────────────────
# Your Gmail address used for SMTP auth (the "From" address)
EMAIL_USER=abhix7435@gmail.com

# Gmail App Password (16-char, NOT your regular Gmail password)
# Get it: Google Account → Security → 2-Step Verification → App passwords
# Create one named "abhix-portfolio"
EMAIL_APP_PASSWORD=rooodrrqetuiumgr

# Where contact form emails land — usually same as EMAIL_USER
OWNER_EMAIL=abhix7435@gmail.com

# ── CORS ──────────────────────────────────────────────────────────────────────
# Your portfolio domain. In local dev, use http://localhost:5173
ALLOWED_ORIGIN=https://www.abhix.in
